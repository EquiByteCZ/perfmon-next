<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <UseWPF>true</UseWPF>
    <RootNamespace>PerfMonNext</RootNamespace>
    <AssemblyName>PerfMonNext</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <Version>0.3.5</Version>
    <Company>EquiByte s.r.o.</Company>
    <Copyright>Copyright (c) 2026 EquiByte s.r.o. MIT License.</Copyright>
    <Product>PerfMon Next</Product>
    <Description>Multi-machine Windows performance counter monitor.</Description>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <NoWarn>$(NoWarn);CA1416</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\PerfMonNext.Core\PerfMonNext.Core.csproj" />
    <ProjectReference Include="..\PerfMonNext.Windows\PerfMonNext.Windows.csproj" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="ScottPlot.WPF" Version="5.0.55" />
  </ItemGroup>
  <ItemGroup>
    <Resource Include="Assets\equibyte-logo.png" />
    <Resource Include="Assets\equibyte-mark.png" />
    <Resource Include="Assets\app.ico" />
  </ItemGroup>
</Project>
