<Window x:Class="PerfMonNext.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="About PerfMon Next" Icon="/Assets/app.ico" SizeToContent="WidthAndHeight" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{StaticResource App.Background}" Foreground="{StaticResource App.Text}" FontFamily="Segoe UI" FontSize="13">
  <Border Padding="24,20" Background="{StaticResource App.Surface}">
    <StackPanel Orientation="Horizontal">
      <Image Source="/Assets/equibyte-logo.png" Width="128" Height="128" VerticalAlignment="Top"
             RenderOptions.BitmapScalingMode="NearestNeighbor" SnapsToDevicePixels="True" Margin="0,0,20,0"/>
      <StackPanel MaxWidth="380">
        <TextBlock Text="PerfMon Next" FontSize="20" FontWeight="SemiBold"/>
        <TextBlock x:Name="VersionText" Foreground="{StaticResource App.Muted}" Margin="0,2,0,12"/>
        <TextBlock TextWrapping="Wrap" Text="Watch Windows performance counters on many machines at once."/>
        <TextBlock Margin="0,10,0,0" TextWrapping="Wrap">
          <Run Text="Open source under the MIT License. Source and releases:"/>
          <LineBreak/>
          <Hyperlink NavigateUri="https://github.com/EquiByteCZ/perfmon-next" RequestNavigate="Link_RequestNavigate" Foreground="{StaticResource App.Accent}">github.com/EquiByteCZ/perfmon-next</Hyperlink>
        </TextBlock>
        <Separator Margin="0,14,0,10" Background="{StaticResource App.Border}"/>
        <DockPanel>
        <Image DockPanel.Dock="Left" Source="/Assets/equibyte-mark.png" Width="28" Height="28" VerticalAlignment="Top" Margin="0,1,10,0"
               RenderOptions.BitmapScalingMode="HighQuality" ToolTip="EquiByte"/>
        <TextBlock TextWrapping="Wrap" Foreground="{StaticResource App.Muted}">
          <Run Text="Built by EquiByte s.r.o. — Azure Local and Hyper-V consulting and deployments."/>
          <LineBreak/>
          <Hyperlink NavigateUri="https://equibyte.cz/en/azure-local/" RequestNavigate="Link_RequestNavigate" Foreground="{StaticResource App.Accent}">equibyte.cz/en/azure-local</Hyperlink>
          <Run Text=" · "/>
          <Hyperlink NavigateUri="mailto:Jaromir@equibyte.cz" RequestNavigate="Link_RequestNavigate" Foreground="{StaticResource App.Accent}">Jaromir@equibyte.cz</Hyperlink>
        </TextBlock>
        </DockPanel>
        <Button Content="Close" Style="{StaticResource QuietButton}" HorizontalAlignment="Right" Margin="0,18,0,0" Padding="14,4" IsCancel="True" IsDefault="True" Click="Close_Click"/>
      </StackPanel>
    </StackPanel>
  </Border>
</Window>
