<UserControl x:Class="PerfMonNext.Views.LiveChartView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ScottPlot="clr-namespace:ScottPlot.WPF;assembly=ScottPlot.WPF"
             Background="#10161D" ClipToBounds="True">
  <Grid>
    <ScottPlot:WpfPlot x:Name="Plot"/>
    <!-- Grafana-style hover: crosshair plus a card with the time and every visible series. -->
    <Canvas x:Name="HoverLayer" IsHitTestVisible="False" Visibility="Collapsed">
      <Line x:Name="Crosshair" Stroke="#8B9CB0" StrokeThickness="1" StrokeDashArray="3 3" SnapsToDevicePixels="True"/>
      <Border x:Name="HoverCard" Background="#EE18212B" BorderBrush="#3A4A5C" BorderThickness="1" CornerRadius="4" Padding="10,8">
        <StackPanel>
          <TextBlock x:Name="HoverTime" Foreground="#C5D0DC" FontSize="11" Margin="0,0,0,6"/>
          <StackPanel x:Name="HoverRows"/>
        </StackPanel>
      </Border>
    </Canvas>
  </Grid>
</UserControl>
